# ─────────────────────────────────────────────────────────────────────────────
#  BorderGuard AI — Streamlit secrets
#
#  Local:            copy to .streamlit/secrets.toml and fill in
#                      cp .streamlit/secrets.toml.example .streamlit/secrets.toml
#  Streamlit Cloud:  your app -> Settings -> Secrets -> paste this block
#
#  Format is TOML (not .env). .streamlit/secrets.toml is gitignored.
#  An .env file with the same names also works — see .env.example.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ─────────────────────────────────────────────────────────────────
# Google AI Studio key for the AI Intelligence Chat page.
# https://aistudio.google.com/apikey
GEMINI_API_KEY = "your-google-ai-studio-key"

# ── CARTO basemap key (optional) ─────────────────────────────────────────────
# The map uses the CARTO dark matter basemap, whose public styles are keyless, so
# the threat map works without this. Uncomment only if you have a CARTO key:
# https://carto.com/
#
# With only CARTO_API_KEY set, the key is appended to the dark-matter style URL.
# With CARTO_STYLE_URL also set, the key is appended to that URL, or substituted
# into a {api_key} / {key} placeholder if one is present.
#
# CARTO_API_KEY = "your-carto-key"

# ── Map style (optional) ─────────────────────────────────────────────────────
# The app is dark-only and defaults to CARTO dark matter. Set this only to point
# at a different style (e.g. a self-hosted one).
#
# CARTO_STYLE_URL = "https://your-style-host/style.json"

# ── Model (optional) ─────────────────────────────────────────────────────────
# Defaults to best.pt next to the app.
#
# MODEL_PATH = "best.pt"
