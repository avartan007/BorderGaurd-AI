# ─────────────────────────────────────────────────────────────────────────────
#  BorderGuard AI — environment variables
#  Copy to `.env` for local runs:      cp .env.example .env
#
#  Where each value goes:
#    • Local:            .env  (or export in your shell)
#    • Streamlit Cloud:  App -> Settings -> Secrets  (TOML, see secrets.toml.example)
#
#  The app reads Streamlit secrets first, then these environment variables.
#  Never commit the real .env — it is gitignored.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ─────────────────────────────────────────────────────────────────
# Google AI Studio key for the "AI Intelligence Chat" page.
# Get one: https://aistudio.google.com/apikey
# If unset, chat falls back to a deterministic summary (the app still runs).
GEMINI_API_KEY=your-google-ai-studio-key

# ── CARTO basemap key (optional) ─────────────────────────────────────────────
# The map uses the CARTO "dark matter" basemap. CARTO's public styles are served
# WITHOUT authentication, so the India threat map works with no key at all.
#
# Add a key only if you want CARTO's keyed terms / higher tile limits.
# Get one: https://carto.com/  ->  Sign up  ->  Developers  ->  API keys
#
# Behaviour when CARTO_API_KEY is set:
#   • No CARTO_STYLE_URL  -> the key is appended to the dark-matter style
#   • CARTO_STYLE_URL set -> the key is appended to it (or substituted into a
#                            {api_key} / {key} placeholder if present)
CARTO_API_KEY=

# ── Map style (optional) ─────────────────────────────────────────────────────
# The app is dark-only; leave this blank to use CARTO dark matter:
#   https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json
#
# Set it only to point at a different style (e.g. a self-hosted one).
# Example with a placeholder (key injected from CARTO_API_KEY):
#   CARTO_STYLE_URL=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json?api_key={api_key}
CARTO_STYLE_URL=

# ── Model (optional) ─────────────────────────────────────────────────────────
# Path to the YOLO weights. Defaults to ./best.pt next to the app.
# MODEL_PATH=best.pt
